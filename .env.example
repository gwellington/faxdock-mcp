# Enter the assigned Telnyx fax number in E.164 format and the Fax API application ID.
TELNYX_FAX_FROM=
TELNYX_FAX_CONNECTION_ID=

# On Linux, use the non-root owner of the bind-mounted folders.
# FAX_UID=1000
# FAX_GID=1000

# Uncomment this line and set the signing public key to enable inbound faxing.
# COMPOSE_FILE=compose.yaml:compose.inbound.yaml
# TELNYX_WEBHOOK_PUBLIC_KEY=
# TELNYX_WEBHOOK_HOST_PORT=8787
